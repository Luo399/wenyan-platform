  "blocks": [
    {
      "type": "quiz",
      "data": {
        "text_id": "WEN_26",
        "question_id": "WEN_26_B1",
        "module": "B",
        "question_number": 1,
        "question_text": "“虽乘奔御风，不以疾也”突出三峡夏水（）",
        "option_a": "风景优美，令人流连",
        "option_b": "暴涨湍急，船行极快",
        "option_c": "气候炎热，难以行舟",
        "option_d": "鱼虾众多，适合捕捞",
        "correct_answer": "B",
        "difficulty": "L2",
        "question_type": "radio",
        "pre_dialog": "渔者：夏日三峡，江水暴涨，舟行其间是什么感受？"
      }
    },
    {
      "type": "dialogue",
      "data": {
        "text_id": "WEN_26",
        "pre_dialog": "渔者：答案是B。夏水襄陵，沿溯阻绝；有时朝发白帝、暮到江陵，千里江陵一日还。即使骑着快马、驾着长风，也没有这样快。这里用夸张和对比，突出夏水暴涨、水流湍急。",
        "icon_dialog": ""
      }
    },
    {
      "type": "quiz",
      "data": {
        "text_id": "WEN_26",
        "question_id": "WEN_26_B2",
        "module": "B",
        "question_number": 2,
        "question_text": "“清荣峻茂”四字概括的是（）",
        "option_a": "夏天三峡江水暴涨、沿溯阻绝的凶险",
        "option_b": "秋天三峡林寒涧肃、高猿长啸的凄凉",
        "option_c": "春冬之时三峡水清、树荣、山高、草盛的景象",
        "option_d": "三峡两岸物产丰富、百姓安居的景象",
        "correct_answer": "C",
        "difficulty": "L3",
        "question_type": "radio",
        "pre_dialog": "行者：郦道元写春冬之景，只用“清荣峻茂”四字，妙在何处？"
      }
    },
    {
      "type": "dialogue",
      "data": {
        "text_id": "WEN_26",
        "pre_dialog": "行者：答案是C。“清”写水清，“荣”写树荣，“峻”写山高，“茂”写草盛，四字分写四景，又合成一幅春冬三峡图。B是秋景，A是夏景，D脱离原文，都不是“清荣峻茂”所指。",
        "icon_dialog": ""
      }
    }
  ]
}
