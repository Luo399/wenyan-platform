# 后端环境配置模板
# 复制此文件为 .env 并填写实际值
# 完整环境总览见 docs/environment-overview.md

# 开发环境配置
# PORT=3000
# CORS_ORIGIN=http://localhost:5173
# AUTH_SECRET=

# 测试环境配置（由 GitHub Actions 自动创建）
# PORT=3001
# CORS_ORIGIN=http://test.classicalab.cn,https://test.classicalab.cn
# AUTH_SECRET=wenyan-test-secret-2024

# 生产环境配置（由 GitHub Actions 通过 Secrets 注入）
# PORT=3000
# CORS_ORIGIN=https://www.classicalab.cn,https://classicalab.cn
# AUTH_SECRET=<从 GitHub Secrets 注入>

# 服务端口
PORT=3000

# CORS 允许的来源（逗号分隔）
CORS_ORIGIN=http://localhost:5173

# JWT 签名密钥（R90 起统一走 JWT Bearer token 鉴权，HMAC AUTH_SECRET 已废弃）
# 生成方法：openssl rand -hex 32
# 注意：生产环境必须设置，缺失时服务启动失败
JWT_SECRET=

# Figma 插件资产同步令牌（ASSET_SYNC_TOKEN）
# 用于 Figma 插件 → 后端上传接口的鉴权，未配置时仅允许本机回环地址访问
# 生成方法：openssl rand -hex 32
# 在 Figma 插件 UI 的"同步令牌"输入框中填入此值
# ASSET_SYNC_TOKEN=

# OSS 公开访问 URL（用于 Figma 插件上传后验证文件存在性）
# 格式：https://{bucket}.{region}.aliyuncs.com
# OSS_PUBLIC_URL=https://wenyan-online.oss-cn-guangzhou.aliyuncs.com
