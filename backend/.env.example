# 后端服务环境配置模板
# 复制此文件为 .env 并填写实际值

# 服务器配置
PORT=3000
HOST=0.0.0.0

# CORS 允许的前端域名（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173

# JWT 密钥（生产环境必填，缺失时服务启动失败；生成方式：openssl rand -hex 32）
# 注意：历史版本曾泄露密钥，生产环境必须使用新生成的强随机密钥，并通过 GitHub Secrets 注入
JWT_SECRET=
# 令牌有效期：支持纯秒数（3600）或单位写法（60s / 30m / 12h / 7d）
# 非法值会导致服务启动失败（F-003：旧实现会静默回退到 3600，改了不生效）
# 教学场景建议按在校时长设置，例如 12h；前端会在过期前调用 /api/auth/refresh 自动续期
JWT_EXPIRES_IN=12h

# JSON 请求体大小限制
JSON_LIMIT=1mb

# 数据目录
DATA_BASE_PATH=./data

# 数据看板访问密码（留空则不限制）
# 前端独立页面 internal-dashboard/index.html 通过此密码验证
DASHBOARD_PASSWORD=

# Figma 同步配置（方式一：服务端 Figma REST API 同步）
# Figma Personal Access Token（从 Figma → Settings → Account → Personal Access Token 获取）
FIGMA_ACCESS_TOKEN=
# 阿里云 OSS 配置（用于 Figma 资源同步 + 资产上传）
# ALIYUN_OSS_REGION=oss-cn-guangzhou
# ALIYUN_OSS_BUCKET=wenyan-online
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# 资产同步配置（方式二：Figma 插件 → 后端上传，推荐）
# POST /api/assets/upload        接收 Figma 插件上传的文件（multipart/form-data）
# GET  /api/assets/version       获取版本信息（version.json）
# POST /api/assets/pre-signed    生成 OSS 预签名 URL（直传模式）
# 上传后 version.json 自动更新，前端通过 ?t=sync_timestamp 刷新缓存

# 资产上传同步令牌（必填，安全红线）
# Figma 插件上传时通过请求头 X-API-Key 携带，与服务器此值比对，不一致返回 401。
# 生成方式：openssl rand -hex 32；通过 GitHub Secrets 注入服务器 .env，禁止进入 git。
# 未配置时仅放行本机回环地址调试，生产环境必须配置。
# ASSET_SYNC_TOKEN=

# 测试模式（不启动实际服务器）
TEST_MODE=false

# ======== 教师后台同步配置（R170）========
# 学生提交答案后，后端 /api/submit 在写入本地 SQLite 的同时，
# 异步推送一份完整答题记录到教师后台，供教师查看学生作业情况。
# 同步失败不阻塞主流程（学生答题已保存本地），仅在日志中 warn。

# 教师后台 API 基础地址（留空则不开启同步）
# 例如：https://teacher.classicalab.cn
TEACHER_BACKEND_URL=

# 教师后台接收答题推送的端点路径
# 例如：/api/answers/sync
TEACHER_BACKEND_SYNC_PATH=/api/answers/sync

# 教师后台 API 密钥（可选，根据教师后台鉴权方式配置）
# 会以 Authorization: Bearer <token> 或 X-Sync-Token: <token> 方式传递
TEACHER_BACKEND_TOKEN=

# 同步超时时间（毫秒）
TEACHER_BACKEND_TIMEOUT_MS=5000

# ======== AI 服务配置 ========
# AI_MAX_OUTPUT_TOKENS=1500
# AI_ALERT_WEBHOOK=   # 可选：飞书 webhook / 钉钉机器人，配额 >80% 或下游异常时告警
