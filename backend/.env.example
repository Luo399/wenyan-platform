# 后端服务环境配置模板
# 复制此文件为 .env 并填写实际值

# 服务器配置
PORT=3000
HOST=0.0.0.0

# CORS 允许的前端域名（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173

# HMAC 签名密钥（用于答题提交鉴权，前后端必须一致）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：历史版本曾泄露过密钥，生产环境必须使用新生成的强随机密钥
AUTH_SECRET=

# JWT 密钥（如使用 JWT 鉴权）
JWT_SECRET=
JWT_EXPIRES_IN=3600

# JSON 请求体大小限制
JSON_LIMIT=10mb

# 数据目录
DATA_BASE_PATH=./data

# 数据看板访问密码（留空则不限制）
# 前端独立页面 internal-dashboard/index.html 通过此密码验证
DASHBOARD_PASSWORD=

# Figma 同步配置
# Figma Personal Access Token（从 Figma → Settings → Account → Personal Access Token 获取）
FIGMA_ACCESS_TOKEN=
# 阿里云 OSS 配置（用于 Figma 资源同步）
# ALIYUN_OSS_REGION=oss-cn-guangzhou
# ALIYUN_OSS_BUCKET=wenyan-online
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# 测试模式（不启动实际服务器）
TEST_MODE=false
