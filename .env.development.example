# 开发/测试环境配置模板
# 复制此文件为 .env.development 并填写真实值（真实 .env 已被 .gitignore 排除）

# ============================================================
# 前端（Vite）配置
# ============================================================
# 后端 API 地址（变量名必须是 VITE_API_BASE_URL，asset.ts 中引用此名）
# 开发：http://localhost:3000
# 测试：https://<test-api-domain>
VITE_API_BASE_URL=https://test-api.example.com

# OSS 资源基础路径（CDN 域名）
# 资源通过该域名下的 /images/、/audio/、/video/、/data/ 路径访问
# 开发：可留空走本地 public/
# 测试：https://<test-domain>
VITE_OSS_BASE_URL=https://test.example.com

# 仅供开发构建：登录弹窗底部展示的测试账号编号，逗号分隔；生产必须留空
VITE_TEST_ACCOUNTS=1,2,3,4,5

# ============================================================
# OSS 上传配置（scripts/upload-to-oss.js 等本地脚本使用）
# ============================================================
# 桶所在 region，必须与桶一致（本项目桶位于中卫）
OSS_REGION=oss-cn-zhongwei

# 阿里云 AccessKey ID/Secret（本地配置，不要提交）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 测试桶名（替换为你的真实桶名）
OSS_BUCKET_TEST=<your-test-bucket>

# ============================================================
# 注意：
# 1. 复制此文件为 .env.development 后填写敏感信息
# 2. .env.development 已被 .gitignore 排除，不会提交到仓库
# 3. VITE_* 会打包进前端，禁止放密钥
# ============================================================
