# 开发环境配置模板
# 复制此文件为 .env.development 并填写真实值

# 后端 API 地址
# 注意：变量名必须为 VITE_API_BASE_URL（asset.ts 中引用此名）
# 生产：https://api.classicalab.cn
# 测试：https://test-api.classicalab.cn
VITE_API_BASE_URL=https://test-api.classicalab.cn

# OSS 资源基础路径（CDN 域名）
# 资源通过该域名下的 /images/、/audio/、/video/、/data/ 路径访问
# 生产：https://classicalab.cn
# 测试：https://test.classicalab.cn
VITE_OSS_BASE_URL=https://test.classicalab.cn

# ============================================================
# 登录 / 调试
# ============================================================
# 允许在开发构建的登录弹窗底部显示"测试账号"提示；
# 空字符串或未设置 = 不显示。多个账号用英文逗号分隔，例如 "1,2,3,4,5"
VITE_TEST_ACCOUNTS=1,2,3,4,5

# ============================================================
# OSS 上传配置（用于 scripts/upload-to-oss.js）
# ============================================================
# OSS 区域，如 oss-cn-hangzhou
OSS_REGION=oss-cn-zhongwei

# 阿里云 AccessKey ID（从阿里云控制台获取，本地配置，不要提交）
OSS_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret（从阿里云控制台获取，本地配置，不要提交）
OSS_ACCESS_KEY_SECRET=

# OSS Bucket 名称
OSS_BUCKET=classic-chinese

# ============================================================
# 注意：
# 1. 复制此文件为 .env.development 后填写敏感信息
# 2. .env.development 文件已被 .gitignore 排除，不会提交到仓库
# 3. 敏感信息请通过环境变量或 .env.local 文件配置
# ============================================================