# 生产环境配置模板
# 复制此文件为 .env.production 后使用（.env.production 已被 .gitignore 排除）
#
# 实际生产构建时，这些值通过 GitHub Actions deploy-frontend.yml 的 env: 注入，
# 优先级高于 .env.production 文件中的值。
#
# 只允许放 VITE_*（会打包进前端产物）。任何密钥（JWT_SECRET / OSS AK/SK /
# DASHBOARD_PASSWORD 等）都只存在于后端 .env 或 GitHub Secrets，禁止放这里。

# 后端 API 地址（生产环境，必须是独立子域）
VITE_API_BASE_URL=https://api.classicalab.cn

# OSS 资源基础路径（CDN 域名）
# 资源通过该域名下的 /images/、/audio/、/video/、/data/ 路径访问
VITE_OSS_BASE_URL=https://www.classicalab.cn

# 生产环境必须为空：不允许在登录弹窗展示测试账号
VITE_TEST_ACCOUNTS=
