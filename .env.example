# 前端环境配置模板
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:3000

# OSS 资源基础路径（生产环境使用）
# 开发环境：使用本地路径
# 生产环境：使用 OSS CDN 地址
VITE_OSS_BASE_URL=

# ============================================================
# OSS 上传配置（用于 scripts/upload-to-oss.js）
# ============================================================
# OSS 区域，如 oss-cn-hangzhou
OSS_REGION=oss-cn-hangzhou

# 阿里云 AccessKey ID（从阿里云控制台获取）
OSS_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret（从阿里云控制台获取）
OSS_ACCESS_KEY_SECRET=

# OSS Bucket 名称
OSS_BUCKET=