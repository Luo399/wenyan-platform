# 根环境配置模板（唯一权威版本；env.example 仅为兼容旧引用保留的指针）
# 复制此文件为 .env.development 或 .env.production 并填写实际值
# 真实 .env 已被 .gitignore 排除，禁止提交任何真实密钥
#
# 变量分两类：
#   VITE_*  构建期注入前端（会打包进 JS，禁止放任何密钥）
#   其余    后端/脚本在本地或服务器使用

# ============================================================
# 前端（Vite）配置
# ============================================================
# 后端 API 地址（必须是独立子域，不能与前端同源）
# 开发：http://localhost:3000
# 测试：https://test-api.example.com
# 生产：https://api.example.com
VITE_API_BASE_URL=http://localhost:3000

# OSS/CDN 资源基础路径（图片/音频/视频/data 都从这里取）
# 开发：可留空走本地 public/
# 测试：https://test.example.com
# 生产：https://www.example.com
VITE_OSS_BASE_URL=

# 仅供开发构建：登录弹窗底部展示的测试账号编号，逗号分隔；生产必须留空
VITE_TEST_ACCOUNTS=1,2,3,4,5

# R90 已移除：VITE_AUTH_SECRET（前端不应持有服务端密钥，鉴权改走 JWT Bearer token）
# JWT_SECRET 只存在于后端 .env，生成：openssl rand -hex 32

# ============================================================
# OSS 上传配置（scripts/upload-to-oss.js、scripts/upload-data-oss.sh）
# ============================================================
# 桶所在 region，必须与桶一致；填错会 AccessDenied 或绕路
# （本项目桶位于中卫，填成 guangzhou/hangzhou 会由 OSS 回 AccessDenied 并给出正确 endpoint）
OSS_REGION=oss-cn-zhongwei

# 阿里云 AccessKey ID/Secret：只填在本地 .env 或服务器环境，禁止提交
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 生产/测试桶名（替换为你的真实桶名，不要沿用示例）
OSS_BUCKET_PROD=<your-prod-bucket>
OSS_BUCKET_TEST=<your-test-bucket>

# ============================================================
# 数据管线配置（data-pipeline/python/data_processor/main.py）
# ============================================================
# 腾讯文档导出目录（--source tencent 时使用）
# 默认 data-pipeline/source/tencent_exports/
TENCENT_DOC_EXPORT_DIR=
