# 前端环境配置模板
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:3000

# OSS 资源基础路径（生产环境使用）
# 开发环境：使用本地路径
# 生产环境：使用 OSS CDN 地址
VITE_OSS_BASE_URL=

# R90 已移除：VITE_AUTH_SECRET（前端不应持有服务端密钥，鉴权改走 JWT Bearer token）

# ============================================================
# 登录 / 调试
# ============================================================
# 允许在开发构建的登录弹窗底部显示"测试账号"提示；
# 空字符串或未设置 = 不显示。多个账号用英文逗号分隔，例如 "1,2,3,4,5"
VITE_TEST_ACCOUNTS=1,2,3,4,5

# ============================================================
# OSS 上传配置（用于 scripts/upload-to-oss.js）
# ============================================================
# OSS 区域，如 oss-cn-hangzhou
OSS_REGION=oss-cn-hangzhou

# 阿里云 AccessKey ID（从阿里云控制台获取）
OSS_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret（从阿里云控制台获取）
OSS_ACCESS_KEY_SECRET=

# OSS Bucket 名称
OSS_BUCKET=

# ============================================================
# 数据管线配置（用于 data-pipeline/python/data_processor/main.py）
# ============================================================
# 腾讯文档导出目录（--source tencent 时使用）
# 用户在 Trae IDE 中通过腾讯文档 MCP 读取在线表格并导出到此目录
# 默认 data-pipeline/source/tencent_exports/
TENCENT_DOC_EXPORT_DIR=